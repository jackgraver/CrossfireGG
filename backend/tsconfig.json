{
    "compilerOptions": {
        "composite": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022"],
        "outDir": "dist",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "declaration": true,
        "sourceMap": true,
        "paths": {
            "@repo/schemas": ["../shared/schemas/src"],
            "@repo/contracts": ["../shared/contracts/src"]
        }
    },
    "include": ["."],
    "exclude": ["node_modules", "dist"],
    "references": [
        { "path": "../shared/schemas" },
        { "path": "../shared/contracts" }
    ]
}
