{
    "compilerOptions": {
        "composite": true,
        "target": "ES2022",
        "module": "CommonJS",
        "lib": ["ES2022"],
        "outDir": "dist",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "moduleResolution": "Node",
        "declaration": true,
        "sourceMap": true,
        "paths": {
            "@repo/contracts": ["../shared/contracts/src"]
        }
    },
    "include": ["."],
    "exclude": ["node_modules", "dist"],
    "references": [{ "path": "../shared/contracts" }]
}
