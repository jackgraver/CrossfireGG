# Copy to backend/.env and fill in secrets.
# Do not commit backend/.env (gitignored).

PORT=5000
NODE_ENV=development

# PostgreSQL — must match db/docker-compose.yml (see MD/local-development-setup.md)
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/cf-db

# Redis (optional but recommended for caching + FACEIT sync locks)
REDIS_URL=redis://localhost:6379

# Frontend origin (frontend dev server runs on port 3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_ORIGIN=http://localhost:5000
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Better Auth (generate: openssl rand -hex 64)
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:5000

# FACEIT OAuth app — create at https://developers.faceit.com/
FACEIT_CLIENT_ID=replace-me
FACEIT_CLIENT_SECRET=replace-me
FACEIT_API_KEY=replace-me
FACEIT_REDIRECT_URI=http://localhost:5000/api/auth/oauth2/callback/faceit

# Optional
SKIP_SYNC=false

# Legacy / unused by config/env.ts but may exist in older .env files
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# FRONTEND_URL=http://localhost:3000
