{
    "compilerOptions": {
        "module": "CommonJS",
        "target": "ES2022",
        "strict": true,
        "declaration": true,
        "composite": true,
        "outDir": "dist",
        "rootDir": "src",
        "moduleResolution": "Node",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true
    }
}
